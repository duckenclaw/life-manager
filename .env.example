# Copy this file to `.env` in the vault root and fill in your values.
# `.env` is git-ignored, so personal values stay out of the repository.

# GitHub username used by Scripts/fetchCommits.js ("Fetch" button in daily notes)
GITHUB_USERNAME=your-github-username

# Apple Reminders sync (Scripts/syncReminders.js, Mac only).
# Tasks/<Note>.md syncs with the Reminders list of the same name (case-insensitive);
# missing lists are created. Map notes to differently named lists here (Note:List, comma-separated).
REMINDERS_LISTS=

# USDA FoodData Central API key, used by the Macros plugin to search foods.
# Get a free key at https://fdc.nal.usda.gov/api-key-signup, then press "Apply .env" on Home.
USDA_API_KEY=
