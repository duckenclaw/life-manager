		"triceps": { "label": "Triceps", "muscles": ["triceps"] },
		"quads": { "label": "Legs (quads)", "muscles": ["quadriceps", "adductors"] },
		"core": { "label": "Abs & lower back", "muscles": ["abdominals", "lower back"] },
		"shoulders": { "label": "Shoulders", "muscles": ["shoulders"] },
		"posterior": { "label": "Legs (hamstrings, glutes, calves)", "muscles": ["hamstrings", "glutes", "calves", "abductors"] }
	},

	"splits": [
		{ "id": "chest_back", "label": "Chest + upper back", "groups": ["chest", "upper_back"] },
		{ "id": "arms", "label": "Biceps + triceps", "groups": ["biceps", "triceps"] },
		{ "id": "quads_core", "label": "Legs + abs/lower back", "groups": ["quads", "core"] },
		{ "id": "shoulders_posterior", "label": "Shoulders + legs", "groups": ["shoulders", "posterior"] }
	],

